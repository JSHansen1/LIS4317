library(ggplot2)
library(dplyr)
library(ggrepel)

# Import Champion Statistics
champion_data <- read.csv("C:/Users/Joshu/Documents/LIS 4370 R Programming/vis analytics/Teamfight Tactics 14.3 Early Data.csv")

# Change percentage strings for Top4 and Won into numeric values
champion_data$Top4 <- as.numeric(sub("%", "", champion_data$Top4))
champion_data$Won <- as.numeric(sub("%", "", champion_data$Won))

# Add Cost of each champion to the data
