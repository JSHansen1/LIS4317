  "Kog'Maw" = 1,
  "Morgana" = 1,
  "Nidalee" = 1,
  "Poppy" = 1,
  "Seraphine" = 1,
  "Shaco" = 1,
  "Sylas" = 1,
  "Vi" = 1,
  "Zyra" = 1,
  
  # 2-Cost Champions
  "Darius" = 2,
  "Ekko" = 2,
  "Graves" = 2,
  "Illaoi" = 2,
  "Jhin" = 2,
  "LeBlanc" = 2,
  "Naafiri" = 2,
  "Rhaast" = 2,
  "Shyvana" = 2,
  "Skarner" = 2,
  "Twisted Fate" = 2,
  "Vayne" = 2,
  "Veigar" = 2,
  
  # 3-Cost Champions
  "Braum" = 3,
