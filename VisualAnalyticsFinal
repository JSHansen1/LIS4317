  "Urgot" = 5,
  "Viego" = 5,
  "Zac" = 5)

champion_data$Cost <- champion_costs[champion_data$Unit]

# Convert Cost to factor
champion_data$Cost <- factor(champion_data$Cost, levels = c(1, 2, 3, 4, 5))

# Assign colors to the champions cost that matches the game
cost_colors <- c("1" = "white", "2" = "green", "3" = "blue", "4" = "purple", "5" = "gold")

# Visualization 1 - Scatterplot of Games Played vs Delta, color coded for champ cost
ggplot(champion_data, aes(x = Games, y = Delta, color = Cost)) +
  geom_point(size = 5) + 
  scale_color_manual(values = cost_colors) + 
  labs(title = "Champion Popularity vs. Performance (Patch 14.3)", x = "Total Games Played",
       y = "Performance Delta (Lower is Better)", color = "Cost Tier") + 
  theme_dark()

# Same visualization with trend lines by champion cost
ggplot(champion_data, aes(x = Games, y = Delta, color = Cost)) +
  geom_point(size = 5) + geom_smooth(method = "lm", se = FALSE, size = 1.5) +
  scale_color_manual(values = cost_colors) + 
  labs(title = "Champion Popularity vs. Performance (Patch 14.3)", x = "Total Games Played",
       y = "Performance Delta (Lower is Better)", color = "Cost Tier") + 
  theme_dark()


# Boxplot visualization of performance delta for the different cost tiers
ggplot(champion_data, aes(x = Cost, y = Delta, fill = Cost)) + 
  geom_boxplot(color = "gray20", outlier.color = "gray20", size = 1) + 
  scale_fill_manual(values = cost_colors) + 
  labs(title = "Delta Distribution by Champion Cost", x = "Champion Cost", y = "Performance Delta (Lower is Better)") +
  theme_dark() + theme(legend.position = "none")


# Scatterplot of Top4% vs Win% by cost tier
ggplot(champion_data, aes(x = Top4, y = Won, color = Cost)) + 
  geom_point(size = 4) + 
  scale_color_manual(values = cost_colors) + 
  labs(title = "Win Rate vs. Top 4 Rate by Champion (Patch 14.3)", x = "Top 4 Rate (Percentage)",
       y = "Win Rate (Percentage)", color = "Champion Cost") +
  theme_dark()

# Identify the outliers for the plot we just made
ggplot(champion_data, aes(x = Top4, y = Won, color = Cost, label = Unit)) +
  geom_point(size = 4) +
  geom_text_repel(data = subset(champion_data, Won > 18 | Won < 10 | Top4 > 60 | Top4 < 40),
    size = 3, color = "white") +
  scale_color_manual(values = cost_colors) +
  labs(title = "Win Rate vs. Top 4 Rate with Outlier Labels", x = "Top 4 Rate (Percentage)",
    y = "Win Rate (Percentage)", color = "Champion Cost") +
  theme_dark()


